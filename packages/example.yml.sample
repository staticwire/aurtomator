# packages/<name>.yml of your repository: ./aurtomator.sh sample > packages/<name>.yml
# Every key: https://aurtomator.dev/package-yaml/
# Every strategy and its upstream fields: https://aurtomator.dev/strategies/

name: my-package          # AUR pkgbase, file name without .yml
strategy: github-release  # how the new version is found
upstream:                 # strategy fields
  project: owner/repo
  # tag_version_regex: '^v([0-9.]+)$'  # ERE whose first group is the version
  # asset_regex: '^app_(.+)_amd64\.deb$'  # github-tag, github-release: value from asset names
  # asset_var: _deb                    # PKGBUILD variable of that value
  # pin_from: zensical                 # pypi: the version that the newest zensical pins with ==
  # registry: bashcov                  # pypi, npm, crates, rubygems: the name in the registry
  # max_answer_mb: 50                  # largest answer of a request, 1 to 500

# allow_downgrade: false     # true publishes versions below current
# allow_version_jump: false  # true publishes versions whose first number gains two digits
# allow_missing_arch: true   # false fails releases without the archive of an arch
# cooldown_days: 0           # days each push waits after the last one, 7 for git-latest
# pkgver_dash: _             # what stands for each - of the upstream version: _, . or ''
# pkgver_format: '4.%s'      # fixed text around the upstream version
# alerts:                    # versions that need a hand edit of the PKGBUILD
#   - from: '2.0.0'
#     hold: true
#     note: Raise makedepends foo to 2
#   - requires: changed      # pypi: the new version adds or drops a requirement
#     hold: true
#   - requires: unmet        # pypi: depends of the AUR miss a requirement of the new version
#     hold: true
#   - requires: imports      # pypi: the new version imports a module that depends miss
# python:                    # Python in depends: none, or where the requirements come from
#   pypi: KubeDiagrams       # the PyPI project of a package of another strategy
#   release: newest          # with pypi: its newest release, as for -git packages
#   pyproject: pyproject.toml  # without pypi: [project] of the source archive
#   map:                     # PyPI name: the Arch package that meets it
#     svg-path: python-svg.path
#   skip: [tools]            # paths of the release that requires: imports leaves out
# ruby:                      # rubygems: gems in depends
#   map:                     # gem name: the Arch package that meets it
#     simplecov: ruby-simplecov
#   skip: [win32ole]         # gems that the requires rules leave out
#   relax: true              # the PKGBUILD turns ~> into >=

# Runs write current, last_updated, current_asset, arch_wait and arch_out.

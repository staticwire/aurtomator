# Example package config. Copy to packages/<name>.yml and edit.
#
# Top-level fields:
#   name       - pkgbase on the AUR, the name of its git repository, equal to
#                the packages/<name>.yml file name (required). It is the
#                package name, except for a split package.
#   strategy   - version detection strategy, see the list below (required)
#   upstream   - strategy-specific settings, see the examples below
#
# Optional:
#   allow_downgrade - true publishes a version lower than current
#   allow_version_jump - true publishes a version whose first number has
#                     at least two digits more than that of current
#   pkgver_dash     - _ or ., stands for each - of the upstream version,
#                     which pkgver cannot hold; the PKGBUILD turns it back
#                     where a URL needs the dash, as in ${pkgver//_/-}.
#                     '' drops the dash: 2.5.0rc1 for 2.5.0-rc1, below
#                     2.5.0, put back as in ${pkgver/rc/-rc}
#   pkgver_format   - the upstream version with a fixed text around it, %s
#                     in its place, as 4.%s for pkgver 4.4215 of build 4215;
#                     the PKGBUILD cuts the text off where a URL needs the
#                     build, as in ${pkgver#4.}
#   alerts          - rules for steps of upstream that need a hand edit,
#                     see the example below and docs/WORKFLOW.md 4.5
#
# Written by update-pkg.sh after every push. Set current by hand only to the
# version the AUR has: for a new package, as the git-latest example of
# docs/WORKFLOW.md 3.7 does, and after a hand publish of a held update (4.5).
#   current      - last pushed version
#   last_updated - date of the last push, YYYY-MM-DD
#   current_asset - value from a release asset name of the last push, for a
#                   package with upstream.asset_var
#
# Strategies:
#   github-release   GitHub Releases API
#   github-tag       GitHub tags, git ls-remote
#   github-nightly   GitHub nightly/prerelease builds (4 patterns)
#   github-asset     GitHub release assets re-uploaded on a fixed tag
#   gitlab-tag       GitLab Tags API (gitlab.com, invent.kde.org, self-hosted)
#   gitea-tag        Gitea / Forgejo / Codeberg Tags
#   git-tag          any HTTPS git repository, git ls-remote
#   git-latest       bare git clone, produces rCOUNT.HASH (for -git packages)
#   pypi             PyPI JSON API
#   npm              npm registry
#   crates           crates.io API
#   repology         Repology API (fallback)
#   archpkg          Arch official repos, pkgver only
#   kde-tarball      download.kde.org directory listing
#   webpage-scrape   any HTTPS page + regex
#
# docs/SUPPORTED-PACKAGES.md covers package types, limitations and safety rules.
# docs/WORKFLOW.md covers strategy details and writing a custom strategy.

# =============================================================================
# MINIMAL EXAMPLE
# =============================================================================

name: my-package
strategy: github-release
upstream:
  project: owner/repo

# =============================================================================
# ALERTS
# =============================================================================
# A rule fires on the step from current to the new version, when the new
# version meets its condition and current does not. hold: true pauses the
# update until the maintainer publishes it by hand and sets current; without
# it the update goes on and the run logs the note.
#
# alerts:
#   - when: major                          # the first number grows
#     note: Create the package for the old major
#   - from: '0.4.0'                        # the version reaches 0.4.0
#     hold: true
#     note: License changes to Apache-2.0
#   - match: '^29\+'                       # ERE on the new version
#     hold: true
#     note: Raise makedepends java-environment to 28

# =============================================================================
# VALUES FROM RELEASE ASSET NAMES
# =============================================================================
# github-tag and github-release only. asset_regex matches the asset names of
# the release of the new version. Exactly one has to match, and its capture
# group goes to the asset_var line of the PKGBUILD, as
# _deb=2.5.0-debian-forky-ocaml5.5.1-1. A new value of the version the AUR
# has is pushed as a rebuild with the next pkgrel. See docs/WORKFLOW.md 4.6.
#
# upstream:
#   project: savonet/liquidsoap
#   asset_regex: '^liquidsoap_([0-9.]+-debian-forky-ocaml5\.[0-9.]+-[0-9]+)_amd64\.deb$'
#   asset_var: _deb                        # a variable name that starts with _

# =============================================================================
# PER-STRATEGY EXAMPLES
# =============================================================================

# --- github-release ---------------------------------------------------------
# Reads /repos/{project}/releases/latest, which skips pre-releases. With
# tag_version_regex, reads the release list, up to 10 pages of 100, and takes
# the matching release published last, pre-releases left out: one product of
# a repository that releases several.
#
# strategy: github-release
# upstream:
#   project: owner/repo                    # required, "owner/repo" format
#   tag_version_regex: '(.+)-stable'       # optional, ERE with a capture group
#   tag_version_replace: '\1'              # optional, \1 to \9 are the groups
#
# A date tag such as 2026-09-10 becomes 2026.09.10 with:
#   tag_version_regex: '^([0-9]{4})-([0-9]{2})-([0-9]{2})$'
#   tag_version_replace: '\1.\2.\3'

# --- github-tag -------------------------------------------------------------
# Reads every tag with git ls-remote and keeps v1.2.3 and 1.2.3.
# tag_version_regex replaces that filter, here to pin the 1.36 line.
#
# strategy: github-tag
# upstream:
#   project: owner/repo                    # required
#   tag_version_regex: '^v(1\.36\.[0-9]+)$'  # optional, ERE with a capture group
#   tag_version_replace: '\1'              # optional, \1 to \9 are the groups

# --- github-nightly ---------------------------------------------------------
# Tracks nightly/prerelease builds in four patterns:
#
#   A) Fixed tag that moves daily (e.g. neovim "nightly"):
#      nightly_tag: nightly
#      version_source: release_body
#      version_pattern: 'NVIM v\K\S+'      # Perl regex
#
#   B) Dated tags like "nightly-2026-03-26":
#      nightly_tag: nightly-
#      version_source: tag_date             # YYYY-MM-DD in the tag, as date_format
#
#      or any tag form, the match published last of up to 300 releases:
#      nightly_tag_regex: '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
#
#   C) Separate nightly repo (e.g. yt-dlp/yt-dlp-nightly-builds):
#      project: yt-dlp/yt-dlp-nightly-builds
#      nightly_tag: latest                  # /releases/latest skips pre-releases
#
#   D) Channel filter (e.g. brave "Nightly" channel):
#      channel: Nightly
#      version_source: tag
#
# strategy: github-nightly
# upstream:
#   project: owner/repo                    # required
#   nightly_tag: nightly                   # optional, default "nightly"
#   nightly_tag_regex: '^nightly-'         # optional, pattern B, in place of nightly_tag and channel
#   version_source: tag                    # optional: tag|release_body|tag_date|published_date
#   version_pattern: 'NVIM v\K\S+'         # required if version_source=release_body
#   channel: Nightly                       # optional, filter by release name
#   tag_version_regex: '(.+)'              # optional, for version_source=tag
#   tag_version_replace: '\1'              # optional, for version_source=tag
#   date_format: '%Y%m%d'                  # optional, for tag_date and published_date,
#                                          # default %Y.%m.%d

# --- github-asset -----------------------------------------------------------
# Tracks assets on a release whose tag never moves (model zoos, rolling
# download tags). Reads /repos/{project}/releases/tags/{tag}. The newest
# updated_at among the listed assets becomes the version as YYYYMMDD.
#
# strategy: github-asset
# upstream:
#   project: owner/repo                    # required
#   tag: models                            # required, release tag that holds the assets
#   assets:                                # required, exact asset file names, at least one
#     - voice-a.tar.bz2
#     - voice-b.tar.bz2

# --- gitlab-tag -------------------------------------------------------------
# Any GitLab instance, public API only (no authentication). Keeps the tags
# v1.2.3 and 1.2.3; tag_version_regex replaces that filter.
#
# strategy: gitlab-tag
# upstream:
#   host: gitlab.com                       # required, hostname without protocol
#   project: group/subgroup/project        # required, full path
#   tag_version_regex: '^mesa-([0-9.]+)$'  # optional, ERE with a capture group
#   tag_version_replace: '\1'              # optional, \1 to \9 are the groups

# --- gitea-tag --------------------------------------------------------------
# Codeberg, self-hosted Gitea/Forgejo. Reads at most 50 tags and keeps
# v1.2.3 and 1.2.3; tag_version_regex replaces that filter.
#
# strategy: gitea-tag
# upstream:
#   host: codeberg.org                     # required
#   project: owner/repo                    # required
#   tag_version_regex: '^release-(.+)$'      # optional, ERE with a capture group
#   tag_version_replace: '\1'              # optional, \1 to \9 are the groups

# --- git-tag ----------------------------------------------------------------
# Any HTTPS git repository: sourcehut, kernel.org, Savannah, or a GitLab or
# Gitea project with more tags than gitlab-tag and gitea-tag read. Reads
# every tag with git ls-remote, without authentication, and keeps v1.2.3
# and 1.2.3; tag_version_regex replaces that filter.
#
# strategy: git-tag
# upstream:
#   url: https://git.sr.ht/~owner/repo     # required, https only
#   tag_version_regex: '^v([0-9.]+)$'      # optional, ERE with a capture group
#   tag_version_replace: '\1'              # optional, \1 to \9 are the groups

# --- git-latest -------------------------------------------------------------
# For -git packages. Produces rCOUNT.HASH (e.g. r435.abc1234), or with
# describe the git describe form of the Arch guidelines (1.4.0.r47.g0bbf5ad).
#
# strategy: git-latest
# upstream:
#   type: github                           # required: github|gitlab|git
#   project: owner/repo                    # required for github|gitlab
#   host: gitlab.example.com               # required for gitlab
#   url: https://example.com/repo.git      # required for type=git, https only
#   branch: develop                        # optional, as #branch= in source;
#                                          # default: the default branch
#   describe: tags                         # optional: tags|annotated
#   tag_prefix: v                          # optional, cut from the tag

# --- pypi / npm / crates ----------------------------------------------------
# Language registries. PyPI returns stable releases only, and crates too
# unless prerelease is true. npm returns the "latest" dist-tag.
#
# strategy: pypi
# upstream:
#   registry: requests                     # required, PyPI package name
#
# strategy: npm
# upstream:
#   registry: express                      # required, npm package name
#
# strategy: crates
# upstream:
#   registry: serde                        # required, crate name
#   prerelease: true                       # optional, reads max_version;
#                                          # needs pkgver_dash

# --- repology ---------------------------------------------------------------
# Fallback when nothing else fits. Returns the version of the first entry
# with status "newest" outside the AUR, or the highest "outdated" one when
# only the AUR is newest. Lags until a distribution packages the release.
#
# strategy: repology
# upstream:
#   repology: project-name                 # optional, defaults to `name` above;
#                                          # a Python, Ruby, Perl or Haskell
#                                          # library is <language>:<name>,
#                                          # as ruby:rmagick

# --- archpkg ----------------------------------------------------------------
# Follows the pkgver of a package in core, extra or multilib, without
# epoch and pkgrel. testing: true also reads their testing repositories
# and takes the newer build. A rebuild there raises only pkgrel and gives
# no new version.
#
# strategy: archpkg
# upstream:
#   archpkg: qt6-base                      # optional, defaults to `name` above
#   testing: true                          # optional, default false

# --- kde-tarball ------------------------------------------------------------
# Reads a directory on https://download.kde.org/ for
# <project>-<version>.tar.xz releases, and the newest version directory in
# it, as for Plasma (stable/plasma/6.8.1/) or Gear (release-service).
#
# strategy: kde-tarball
# upstream:
#   project: alkimia                       # optional, defaults to `name` above
#   path: unstable/alkimia                 # optional, defaults to stable/<project>

# --- webpage-scrape ---------------------------------------------------------
# Any HTTPS page + regex, for upstreams without an API.
# HTTPS only. At most 5 MB, 5 redirects, 30 s timeout.
#
# strategy: webpage-scrape
# upstream:
#   url: https://example.com/downloads/    # required, HTTPS only
#   pattern: 'app-([0-9]+\.[0-9]+)\.tar\.gz'  # required, ERE, the first capture group is the version
#   user_agent: 'Example/2.0 (+https://example.com/bot)'  # optional, default aurtomator/1.0, printable ASCII

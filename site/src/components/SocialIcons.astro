---
import { Icon } from '@astrojs/starlight/components';
// VERSION names the latest release; docs.yml builds the site again when it changes.
import version from '../../../VERSION?raw';

const repo = 'staticwire/aurtomator';
---

<a class="repo sl-flex" href={`https://github.com/${repo}`} rel="me">
  <Icon name="github" size="1.5rem" />
  <span class="facts">
    <span class="name">{repo}</span>
    <span class="tag">
      <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
        <path d="M2 2h6l6 6-6 6-6-6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        <circle cx="5.5" cy="5.5" r="1.25" fill="currentColor" />
      </svg>
      v{version.trim()}
    </span>
  </span>
</a>

<style>
  .repo { align-items: center; gap: 0.5rem; color: var(--sl-color-gray-2); text-decoration: none; line-height: 1.25; }
  .repo:hover { color: var(--sl-color-white); }
  .facts { display: flex; flex-direction: column; font-size: var(--sl-text-xs); }
  .name { font-weight: 600; }
  .tag { display: flex; align-items: center; gap: 0.3rem; }
</style>
